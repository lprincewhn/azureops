FROM python:3.12-slim
WORKDIR /app
COPY batch-requirements.txt ./
RUN pip install --no-cache-dir -r batch-requirements.txt
COPY batch_collector.py contract.py ./
RUN useradd --system --uid 10001 --create-home collector \
    && mkdir -p /data && chown collector:collector /data
USER collector
ENV PYTHONUNBUFFERED=1
CMD ["python", "batch_collector.py"]
