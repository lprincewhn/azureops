{
  "actionGroupId": {
    "metadata": {
      "description": "用于接收 MySQL 告警的 Action Group 资源 ID。",
      "displayName": "Action Group Resource ID"
    },
    "type": "String"
  },
  "cpuThreshold": {
    "defaultValue": 80,
    "metadata": {
      "description": "CPU 使用率百分比平均值超过该值时触发告警。",
      "displayName": "CPU 阈值"
    },
    "type": "Integer"
  },
  "memoryThreshold": {
    "defaultValue": 80,
    "metadata": {
      "description": "内存使用率百分比平均值超过该值时触发告警。",
      "displayName": "内存阈值"
    },
    "type": "Integer"
  },
  "storageThreshold": {
    "defaultValue": 85,
    "metadata": {
      "description": "存储使用率百分比平均值超过该值时触发告警。",
      "displayName": "存储阈值"
    },
    "type": "Integer"
  },
  "effect": {
    "allowedValues": [
      "DeployIfNotExists",
      "Disabled"
    ],
    "defaultValue": "DeployIfNotExists",
    "metadata": {
      "description": "启用自动部署或禁用策略。",
      "displayName": "策略效果"
    },
    "type": "String"
  }
}
