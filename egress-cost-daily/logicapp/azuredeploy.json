{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "每日出网流量费用 Logic App（Consumption）。Recurrence 触发 -> HTTP 调 Cost Management（托管标识）-> ACS Email 连接器发邮件（含真实金额）。无需 Python，无需邮箱账号。"
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "egress-cost-logic",
      "metadata": { "description": "Logic App 名称" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "部署区域" }
    },
    "targetSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": { "description": "查询费用的订阅 ID" }
    },
    "meterCategory": {
      "type": "string",
      "defaultValue": "Bandwidth",
      "metadata": { "description": "计费类别过滤（默认 Bandwidth 捕获出网流量）" }
    },
    "emailSender": {
      "type": "string",
      "metadata": { "description": "ACS 发件地址，如 DoNotReply@<域>.azurecomm.net" }
    },
    "emailRecipients": {
      "type": "string",
      "metadata": { "description": "收件人邮箱，多个用分号(;)分隔" }
    },
    "acsConnectionString": {
      "type": "securestring",
      "metadata": { "description": "Azure Communication Services 连接字符串（endpoint=...;accesskey=...）" }
    },
    "scheduleHour": {
      "type": "int",
      "defaultValue": 2,
      "metadata": { "description": "每天触发的小时（UTC，0-23）" }
    }
  },
  "variables": {
    "acsConnectionName": "[concat(parameters('logicAppName'), '-acsemail')]",
    "acsEmailApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/acsemail')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('acsConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "acsemail",
        "api": {
          "id": "[variables('acsEmailApiId')]"
        },
        "parameterValues": {
          "api_key": "[parameters('acsConnectionString')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('acsConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "sender": {
              "type": "String",
              "defaultValue": "[parameters('emailSender')]"
            },
            "recipients": {
              "type": "String",
              "defaultValue": "[parameters('emailRecipients')]"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "timeZone": "UTC",
                "schedule": {
                  "hours": "[array(parameters('scheduleHour'))]",
                  "minutes": [ 0 ]
                }
              }
            }
          },
          "actions": {
            "Query_cost": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "[concat('https://management.azure.com/subscriptions/', parameters('targetSubscriptionId'), '/providers/Microsoft.CostManagement/query?api-version=2023-11-01')]",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://management.azure.com/"
                },
                "body": {
                  "type": "ActualCost",
                  "timeframe": "Custom",
                  "timePeriod": {
                    "from": "@{formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-ddT00:00:00Z')}",
                    "to": "@{formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-ddT23:59:59Z')}"
                  },
                  "dataset": {
                    "granularity": "None",
                    "aggregation": {
                      "totalCost": { "name": "PreTaxCost", "function": "Sum" }
                    },
                    "filter": {
                      "dimensions": {
                        "name": "MeterCategory",
                        "operator": "In",
                        "values": [ "[parameters('meterCategory')]" ]
                      }
                    }
                  }
                }
              }
            },
            "Compose_cost": {
              "type": "Compose",
              "runAfter": { "Query_cost": [ "Succeeded" ] },
              "inputs": "@if(greater(length(body('Query_cost')?['properties']?['rows']), 0), first(body('Query_cost')?['properties']?['rows'])?[0], 0)"
            },
            "Compose_currency": {
              "type": "Compose",
              "runAfter": { "Compose_cost": [ "Succeeded" ] },
              "inputs": "@if(greater(length(body('Query_cost')?['properties']?['rows']), 0), first(body('Query_cost')?['properties']?['rows'])?[1], 'USD')"
            },
            "Select_recipients": {
              "type": "Select",
              "runAfter": { "Compose_currency": [ "Succeeded" ] },
              "inputs": {
                "from": "@split(parameters('recipients'), ';')",
                "select": {
                  "address": "@trim(item())"
                }
              }
            },
            "Send_email": {
              "type": "ApiConnection",
              "runAfter": { "Select_recipients": [ "Succeeded" ] },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['acsemail']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/emails:sendGAVersion",
                "queries": {
                  "api-version": "2023-03-31"
                },
                "body": {
                  "senderAddress": "@parameters('sender')",
                  "recipients": {
                    "to": "@body('Select_recipients')"
                  },
                  "content": {
                    "subject": "@{concat('[出网费用] ', formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-dd'), ' 合计 ', string(outputs('Compose_cost')), ' ', string(outputs('Compose_currency')))}",
                    "html": "<div style='font-family:Segoe UI,Arial,sans-serif;font-size:14px'><h3>出网流量费用日报 · @{formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-dd')}</h3><p>合计：<b>@{string(outputs('Compose_cost'))} @{string(outputs('Compose_currency'))}</b></p><p style='color:#888;font-size:12px'>由 Logic App 自动生成（数据来源：Cost Management）。</p></div>"
                  },
                  "importance": "Normal"
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "acsemail": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('acsConnectionName'))]",
                "connectionName": "[variables('acsConnectionName')]",
                "id": "[variables('acsEmailApiId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
    },
    "acsConnectionName": {
      "type": "string",
      "value": "[variables('acsConnectionName')]"
    }
  }
}
